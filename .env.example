# LNMIIT Heritage needs no environment variables to install, build or run.
# There is no database, backend, login or API key, so you do not need to create a .env file.
#
# The one optional setting is listed below for reference. scripts/serve.mjs reads it from
# the shell, not from a .env file, for example: PORT=4000 pnpm start
# To change the dev server port instead, run: pnpm run dev --port 3001

# Port used by `pnpm start`. Optional. Defaults to 3000.
PORT=3000
